{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obd-ai.local/schemas/technical-claim-v1.json",
  "title": "TechnicalClaimCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["subjectType", "subjectId", "predicate", "value", "confidence", "riskLevel", "evidence"],
  "properties": {
    "subjectType": {
      "type": "string",
      "enum": ["manufacturer", "vehicle_model", "model_generation", "engine", "vehicle_variant", "ecu_family", "module_installation", "diagnostic_parameter", "dtc", "procedure"]
    },
    "subjectId": { "type": "string", "format": "uuid" },
    "predicate": { "type": "string", "minLength": 1, "maxLength": 120 },
    "value": {},
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskLevel": { "type": "string", "enum": ["low", "normal", "high", "safety_critical"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "role", "locator"],
        "properties": {
          "sourceId": { "type": "string", "format": "uuid" },
          "documentChunkId": { "type": ["string", "null"], "format": "uuid" },
          "role": { "type": "string", "enum": ["supports", "contradicts", "context"] },
          "locator": { "type": "object" },
          "excerpt": { "type": ["string", "null"], "maxLength": 1000 }
        }
      }
    }
  }
}
